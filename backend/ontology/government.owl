  <rdf:Description rdf:about="http://gov.semantic.in/document/HospitalDischarge">
    <rdf:type rdf:resource="http://gov.semantic.in/ontology#RequiredDocument"/>
    <rdfs:label>Institutional Birth Discharge Proof</rdfs:label>
    <gov:hasDescription>Official discharge summary and birth report slip issued by hospital medical superintendent.</gov:hasDescription>
  </rdf:Description>
  <rdf:Description rdf:about="http://gov.semantic.in/service/PassportFreshApplication">
    <rdf:type rdf:resource="http://gov.semantic.in/ontology#TravelService"/>
    <gov:serviceName>Passport Fresh Issuance</gov:serviceName>
    <gov:serviceCode>MEA-SRV-001</gov:serviceCode>
    <gov:belongsToDepartment rdf:resource="http://gov.semantic.in/department/PassportSeva"/>
    <gov:hasCategory rdf:resource="http://gov.semantic.in/category/Travel"/>
    <gov:requiresDocument rdf:resource="http://gov.semantic.in/document/ProofOfAddress"/>
    <gov:requiresDocument rdf:resource="http://gov.semantic.in/document/ProofOfDOB"/>
    <gov:associatedWithConcept rdf:resource="http://gov.semantic.in/concept/IdentityCard"/>
    <gov:relatedTo rdf:resource="http://gov.semantic.in/service/PassportRenewalReissue"/>
    <gov:hasDescription>Official government credential granting permission for international border crossing and travel to sovereign states.</gov:hasDescription>
    <gov:hasApplicationProcedure>1. Register on Passport Seva Portal -&gt; 2. Complete online application -&gt; 3. Pay fee and book PSK appointment -&gt; 4. Present original documents &amp; biometrics at PSK -&gt; 5. Local police physical verification -&gt; 6. Dispatched via Speed Post.</gov:hasApplicationProcedure>
    <gov:officialPortalUrl>https://www.passportindia.gov.in</gov:officialPortalUrl>
    <gov:processingTime>7 to 21 Days (Normal) / 3 Days (Tatkaal)</gov:processingTime>
    <gov:serviceFee>Rs 1,500 (36 pages) / Rs 2,000 (60 pages)</gov:serviceFee>
    <gov:hasSynonym>apply for new passport</gov:hasSynonym>
    <gov:hasSynonym>get indian passport</gov:hasSynonym>
    <gov:hasSynonym>fresh passport application</gov:hasSynonym>
    <gov:hasSynonym>international travel card</gov:hasSynonym>
    <gov:hasSynonym>passport apply</gov:hasSynonym>
  </rdf:Description>
  <rdf:Description rdf:about="http://gov.semantic.in/service/PANCardCorrection">
    <rdf:type rdf:resource="http://gov.semantic.in/ontology#FinancialService"/>
    <gov:serviceName>PAN Card Correction and Reprint</gov:serviceName>
    <gov:serviceCode>CBDT-SRV-002</gov:serviceCode>
    <gov:belongsToDepartment rdf:resource="http://gov.semantic.in/department/IncomeTax"/>
    <gov:hasCategory rdf:resource="http://gov.semantic.in/category/Finance"/>
    <gov:requiresDocument rdf:resource="http://gov.semantic.in/document/ProofOfIdentity"/>
    <gov:requiresDocument rdf:resource="http://gov.semantic.in/document/ProofOfAddress"/>
    <gov:associatedWithConcept rdf:resource="http://gov.semantic.in/concept/TaxIdentification"/>
    <gov:relatedTo rdf:resource="http://gov.semantic.in/service/PANCardNewApplication"/>
    <gov:hasDescription>Correction of misspelled names, father's name, birth dates, or reprinting lost/damaged PAN cards.</gov:hasDescription>
    <gov:hasApplicationProcedure>1. Open NSDL Changes / Correction application -&gt; 2. Enter 10-digit PAN -&gt; 3. Tick checkboxes for attributes to rectify -&gt; 4. Upload documentary justification -&gt; 5. e-Sign using Aadhaar OTP.</gov:hasApplicationProcedure>
    <gov:officialPortalUrl>https://www.onlineservices.nsdl.com</gov:officialPortalUrl>
    <gov:processingTime>7 to 14 Business Days</gov:processingTime>
    <gov:serviceFee>Rs 107</gov:serviceFee>
    <gov:hasSynonym>lost pan card reprint</gov:hasSynonym>
    <gov:hasSynonym>change name in pan card</gov:hasSynonym>
    <gov:hasSynonym>correct date of birth in pan</gov:hasSynonym>
    <gov:hasSynonym>damaged pan replacement</gov:hasSynonym>
    <gov:hasSynonym>pan card duplicate</gov:hasSynonym>
  </rdf:Description>
  <rdf:Description rdf:about="http://gov.semantic.in/service/BirthCertificateRegistration">
    <rdf:type rdf:resource="http://gov.semantic.in/ontology#IdentityService"/>
    <gov:serviceName>Birth Certificate Registration</gov:serviceName>
    <gov:serviceCode>CRS-SRV-001</gov:serviceCode>
    <gov:belongsToDepartment rdf:resource="http://gov.semantic.in/department/CRS"/>
    <gov:hasCategory rdf:resource="http://gov.semantic.in/category/Vital"/>
    <gov:requiresDocument rdf:resource="http://gov.semantic.in/document/HospitalDischarge"/>
    <gov:requiresDocument rdf:resource="http://gov.semantic.in/document/ProofOfAddress"/>
    <gov:associatedWithConcept rdf:resource="http://gov.semantic.in/concept/IdentityCard"/>
    <gov:hasDescription>Statutory legal registration of child birth under Registration of Births and Deaths Act establishing legal existence.</gov:hasDescription>
    <gov:hasApplicationProcedure>1. Hospital reports birth event to registrar or parent applies on crsorgi.gov.in -&gt; 2. Verify parental identity -&gt; 3. Municipal Registrar approves -&gt; 4. Digitally verifiable QR code certificate generated.</gov:hasApplicationProcedure>
    <gov:officialPortalUrl>https://crsorgi.gov.in</gov:officialPortalUrl>
    <gov:processingTime>7 to 14 Days</gov:processingTime>
    <gov:serviceFee>Free within 21 days (Late fee applicable thereafter)</gov:serviceFee>
    <gov:hasSynonym>apply birth certificate</gov:hasSynonym>
    <gov:hasSynonym>janam praman patra</gov:hasSynonym>
    <gov:hasSynonym>register new child birth</gov:hasSynonym>
    <gov:hasSynonym>download municipal birth certificate</gov:hasSynonym>
  </rdf:Description>
  <rdf:Description rdf:about="http://gov.semantic.in/ontology#DateOfBirthDocument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://gov.semantic.in/ontology#RequiredDocument"/>
    <rdfs:label>Proof of Date of Birth (PDB)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://gov.semantic.in/service/VoterIDNewRegistration">
    <rdf:type rdf:resource="http://gov.semantic.in/ontology#WelfareService"/>
    <gov:serviceName>Voter ID New Registration (Form 6)</gov:serviceName>
    <gov:serviceCode>ECI-SRV-001</gov:serviceCode>
    <gov:belongsToDepartment rdf:resource="http://gov.semantic.in/department/ECI"/>
    <gov:hasCategory rdf:resource="http://gov.semantic.in/category/Electoral"/>
    <gov:requiresDocument rdf:resource="http://gov.semantic.in/document/ProofOfAddress"/>
    <gov:requiresDocument rdf:resource="http://gov.semantic.in/document/ProofOfDOB"/>
    <gov:associatedWithConcept rdf:resource="http://gov.semantic.in/concept/ElectoralRegistration"/>
    <gov:relatedTo rdf:resource="http://gov.semantic.in/service/VoterIDAddressCorrection"/>
    <gov:hasDescription>Enrollment of first-time Indian citizens reaching age 18 into the statutory electoral roll with an Electronic Photo Identity Card (EPIC).</gov:hasDescription>
    <gov:hasApplicationProcedure>1. Access voters.eci.gov.in -&gt; 2. Fill Form 6 -&gt; 3. Upload passport photo, age proof, and address proof -&gt; 4. Booth Level Officer (BLO) performs field verification -&gt; 5. Download e-EPIC and receive physical card.</gov:hasApplicationProcedure>
    <gov:officialPortalUrl>https://voters.eci.gov.in</gov:officialPortalUrl>
    <gov:processingTime>15 to 30 Business Days</gov:processingTime>
    <gov:serviceFee>Free of Cost</gov:serviceFee>
    <gov:hasSynonym>apply for new voter id</gov:hasSynonym>
    <gov:hasSynonym>form 6 online</gov:hasSynonym>
    <gov:hasSynonym>first time voter registration</gov:hasSynonym>
    <gov:hasSynonym>get election card</gov:hasSynonym>
    <gov:hasSynonym>epic card apply</gov:hasSynonym>
  </rdf:Description>
  <rdf:Description rdf:about="http://gov.semantic.in/department/PDS">
    <rdf:type rdf:resource="http://gov.semantic.in/ontology#GovernmentDepartment"/>
    <gov:departmentName>Department of Food &amp; Public Distribution (PDS / NFSA)</gov:departmentName>
    <gov:ministryName>Ministry of Consumer Affairs, Food &amp; Public Distribution</gov:ministryName>
    <gov:hasDescription>Administers National Food Security Act (NFSA), Targeted Public Distribution System, and Ration Cards.</gov:hasDescription>
    <gov:officialPortalUrl>https://nfsa.gov.in</gov:officialPortalUrl>
  </rdf:Description>
  <rdf:Description rdf:about="http://gov.semantic.in/service/AadhaarMobileLink">
    <rdf:type rdf:resource="http://gov.semantic.in/ontology#IdentityService"/>
    <gov:serviceName>Aadhaar Mobile &amp; Email Update</gov:serviceName>
    <gov:serviceCode>UIDAI-SRV-003</gov:serviceCode>
    <gov:belongsToDepartment rdf:resource="http://gov.semantic.in/department/UIDAI"/>
    <gov:hasCategory rdf:resource="http://gov.semantic.in/category/Identity"/>
    <gov:associatedWithConcept rdf:resource="http://gov.semantic.in/concept/IdentityCard"/>
    <gov:relatedTo rdf:resource="http://gov.semantic.in/service/AadhaarAddressUpdate"/>
    <gov:hasDescription>Link or update your valid mobile number and email ID in Aadhaar records to enable OTP-based authentication for digital services.</gov:hasDescription>
    <gov:hasApplicationProcedure>1. Visit any Aadhaar Seva Kendra or post office CEPT center -&gt; 2. Biometric fingerprint verification -&gt; 3. Operator enters new phone number -&gt; 4. Verify with instant SMS OTP -&gt; 5. Fee Rs 50.</gov:hasApplicationProcedure>
    <gov:officialPortalUrl>https://uidai.gov.in</gov:officialPortalUrl>
    <gov:processingTime>24 to 72 Hours</gov:processingTime>
    <gov:serviceFee>Rs 50</gov:serviceFee>
    <gov:hasSynonym>link phone number to aadhaar</gov:hasSynonym>
    <gov:hasSynonym>change mobile number in aadhaar</gov:hasSynonym>
    <gov:hasSynonym>aadhaar otp phone change</gov:hasSynonym>
    <gov:hasSynonym>update email in aadhaar</gov:hasSynonym>
  </rdf:Description>
  <rdf:Description rdf:about="http://gov.semantic.in/document/ProofOfDOB">
    <rdf:type rdf:resource="http://gov.semantic.in/ontology#DateOfBirthDocument"/>
    <rdfs:label>Proof of Date of Birth (PDB)</rdfs:label>
    <gov:hasDescription>Birth Certificate, 10th Standard Marks Sheet, Passport, or PAN Card.</gov:hasDescription>
  </rdf:Description>
  <rdf:Description rdf:about="http://gov.semantic.in/service/DrivingLicencePermanent">
    <rdf:type rdf:resource="http://gov.semantic.in/ontology#TransportService"/>
    <gov:serviceName>Permanent Driving Licence (DL)</gov:serviceName>
    <gov:serviceCode>MORTH-SRV-002</gov:serviceCode>
    <gov:belongsToDepartment rdf:resource="http://gov.semantic.in/department/Transport"/>
    <gov:hasCategory rdf:resource="http://gov.semantic.in/category/Transport"/>
    <gov:associatedWithConcept rdf:resource="http://gov.semantic.in/concept/DrivingLicence"/>
    <gov:relatedTo rdf:resource="http://gov.semantic.in/service/DrivingLicenceLearner"/>
    <gov:relatedTo rdf:resource="http://gov.semantic.in/service/DrivingLicenceRenewal"/>
    <gov:hasDescription>Full legal authorization smart card granting permission to drive motor vehicles across India.</gov:hasDescription>
    <gov:hasApplicationProcedure>1. Visit sarathi.parivahan.gov.in after 30 days of holding valid LL -&gt; 2. Enter LL number -&gt; 3. Book practical driving track test slot -&gt; 4. Clear physical driving test before Motor Vehicle Inspector -&gt; 5. Card delivered.</gov:hasApplicationProcedure>
    <gov:officialPortalUrl>https://sarathi.parivahan.gov.in</gov:officialPortalUrl>
    <gov:processingTime>7 to 15 Days after test</gov:processingTime>
    <gov:serviceFee>Rs 200 + Rs 200 Smart Card Fee</gov:serviceFee>
    <gov:hasSynonym>permanent driving licence</gov:hasSynonym>
    <gov:hasSynonym>driving test slot</gov:hasSynonym>
    <gov:hasSynonym>convert learner to dl</gov:hasSynonym>
    <gov:hasSynonym>apply dl</gov:hasSynonym>
    <gov:hasSynonym>four wheeler licence</gov:hasSynonym>
  </rdf:Description>

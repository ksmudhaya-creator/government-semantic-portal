  <rdf:Description rdf:about="http://gov.semantic.in/service/AadhaarAddressUpdate">
    <rdf:type rdf:resource="http://gov.semantic.in/ontology#IdentityService"/>
    <gov:serviceName>Aadhaar Address Update</gov:serviceName>
    <gov:serviceCode>UIDAI-SRV-001</gov:serviceCode>
    <gov:belongsToDepartment rdf:resource="http://gov.semantic.in/department/UIDAI"/>
    <gov:hasCategory rdf:resource="http://gov.semantic.in/category/Identity"/>
    <gov:requiresDocument rdf:resource="http://gov.semantic.in/document/ProofOfAddress"/>
    <gov:associatedWithConcept rdf:resource="http://gov.semantic.in/concept/ResidentialAddress"/>
    <gov:relatedTo rdf:resource="http://gov.semantic.in/service/AadhaarNewEnrollment"/>
    <gov:relatedTo rdf:resource="http://gov.semantic.in/service/AadhaarMobileLink"/>
    <gov:hasDescription>Update or correct your permanent and present residential address in your Aadhaar profile with supporting documentary evidence.</gov:hasDescription>
    <gov:hasApplicationProcedure>1. Sign in to myaadhaar.uidai.gov.in using Aadhaar &amp; OTP -&gt; 2. Select 'Update Address in Aadhaar Online' -&gt; 3. Enter new address details -&gt; 4. Upload valid supporting POA document -&gt; 5. Pay Rs 50 -&gt; 6. Track via Service Request Number (SRN).</gov:hasApplicationProcedure>
    <gov:officialPortalUrl>https://myaadhaar.uidai.gov.in</gov:officialPortalUrl>
    <gov:processingTime>5 to 10 Business Days</gov:processingTime>
    <gov:serviceFee>Rs 50 (Online Portal)</gov:serviceFee>
    <gov:hasSynonym>change house location in aadhaar</gov:hasSynonym>
    <gov:hasSynonym>change address in aadhaar</gov:hasSynonym>
    <gov:hasSynonym>update aadhaar location</gov:hasSynonym>
    <gov:hasSynonym>aadhaar address correction</gov:hasSynonym>
    <gov:hasSynonym>modify home address aadhaar</gov:hasSynonym>
    <gov:hasSynonym>shift home aadhaar</gov:hasSynonym>
    <gov:hasSynonym>new address in aadhar</gov:hasSynonym>
    <gov:hasSynonym>aadhaar me pata badalna</gov:hasSynonym>
  </rdf:Description>

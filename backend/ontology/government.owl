  <rdf:Description rdf:about="http://gov.semantic.in/service/PANCardNewApplication">
    <rdf:type rdf:resource="http://gov.semantic.in/ontology#FinancialService"/>
    <gov:serviceName>PAN Card New Application (Form 49A)</gov:serviceName>
    <gov:serviceCode>CBDT-SRV-001</gov:serviceCode>
    <gov:belongsToDepartment rdf:resource="http://gov.semantic.in/department/IncomeTax"/>
    <gov:hasCategory rdf:resource="http://gov.semantic.in/category/Finance"/>
    <gov:requiresDocument rdf:resource="http://gov.semantic.in/document/ProofOfIdentity"/>
    <gov:requiresDocument rdf:resource="http://gov.semantic.in/document/ProofOfAddress"/>
    <gov:requiresDocument rdf:resource="http://gov.semantic.in/document/ProofOfDOB"/>
    <gov:associatedWithConcept rdf:resource="http://gov.semantic.in/concept/TaxIdentification"/>
    <gov:relatedTo rdf:resource="http://gov.semantic.in/service/PANCardCorrection"/>
    <gov:hasDescription>Issue of 10-digit alphanumeric Permanent Account Number (PAN) mandatory for taxable entities and financial operations in India.</gov:hasDescription>
    <gov:hasApplicationProcedure>1. Access Protean NSDL or UTIITSL portal -&gt; 2. Select Form 49A (Indian Citizens) -&gt; 3. Input applicant details -&gt; 4. Instant paperless verification via Aadhaar e-KYC -&gt; 5. Pay fee -&gt; 6. e-PAN issued in 24 hours, physical card dispatched.</gov:hasApplicationProcedure>
    <gov:officialPortalUrl>https://www.onlineservices.nsdl.com/paam/endUserRegisterContact.html</gov:officialPortalUrl>
    <gov:processingTime>24 Hours (e-PAN) / 10 Days (Physical)</gov:processingTime>
    <gov:serviceFee>Rs 72 (e-PAN) / Rs 107 (Physical Card)</gov:serviceFee>
    <gov:hasSynonym>how do i get a pan card</gov:hasSynonym>
    <gov:hasSynonym>apply for new pan card</gov:hasSynonym>
    <gov:hasSynonym>form 49a online</gov:hasSynonym>
    <gov:hasSynonym>income tax card</gov:hasSynonym>
    <gov:hasSynonym>pan card apply</gov:hasSynonym>
    <gov:hasSynonym>get tax id</gov:hasSynonym>
  </rdf:Description>

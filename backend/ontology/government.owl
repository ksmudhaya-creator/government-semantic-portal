  <rdf:Description rdf:about="http://gov.semantic.in/service/VoterIDAddressCorrection">
    <rdf:type rdf:resource="http://gov.semantic.in/ontology#WelfareService"/>
    <gov:serviceName>Voter ID Address Change and Shifting (Form 8)</gov:serviceName>
    <gov:serviceCode>ECI-SRV-002</gov:serviceCode>
    <gov:belongsToDepartment rdf:resource="http://gov.semantic.in/department/ECI"/>
    <gov:hasCategory rdf:resource="http://gov.semantic.in/category/Electoral"/>
    <gov:requiresDocument rdf:resource="http://gov.semantic.in/document/ProofOfAddress"/>
    <gov:associatedWithConcept rdf:resource="http://gov.semantic.in/concept/ResidentialAddress"/>
    <gov:associatedWithConcept rdf:resource="http://gov.semantic.in/concept/ElectoralRegistration"/>
    <gov:relatedTo rdf:resource="http://gov.semantic.in/service/VoterIDNewRegistration"/>
    <gov:hasDescription>Shifting of constituency or residence address in electoral records and correction of biographical particulars in Voter ID.</gov:hasDescription>
    <gov:hasApplicationProcedure>1. Open voters.eci.gov.in -&gt; 2. Select Form 8 -&gt; 3. Enter current EPIC number -&gt; 4. Select 'Shifting of Residence' -&gt; 5. Enter new constituency and house address -&gt; 6. Submit proof -&gt; 7. BLO verification.</gov:hasApplicationProcedure>
    <gov:officialPortalUrl>https://voters.eci.gov.in</gov:officialPortalUrl>
    <gov:processingTime>14 to 28 Days</gov:processingTime>
    <gov:serviceFee>Free of Cost</gov:serviceFee>

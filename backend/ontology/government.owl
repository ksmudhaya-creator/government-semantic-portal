    <gov:hasSynonym>shift voter id constituency</gov:hasSynonym>
    <gov:hasSynonym>form 8 online</gov:hasSynonym>
    <gov:hasSynonym>update residence in epic</gov:hasSynonym>
    <gov:hasSynonym>voter card correction</gov:hasSynonym>
  </rdf:Description>

    <gov:hasSynonym>living place</gov:hasSynonym>
    <gov:hasSynonym>home address</gov:hasSynonym>
    <gov:hasSynonym>flat address</gov:hasSynonym>
    <gov:hasSynonym>shifting house</gov:hasSynonym>
    <gov:hasSynonym>relocation</gov:hasSynonym>
    <gov:hasSynonym>moved to new city</gov:hasSynonym>
    <gov:hasSynonym>pata badalna</gov:hasSynonym>
  </rdf:Description>
  <rdf:Description rdf:about="http://gov.semantic.in/service/DrivingLicenceRenewal">
    <rdf:type rdf:resource="http://gov.semantic.in/ontology#TransportService"/>
    <gov:serviceName>Driving Licence Renewal</gov:serviceName>
    <gov:serviceCode>MORTH-SRV-003</gov:serviceCode>
    <gov:belongsToDepartment rdf:resource="http://gov.semantic.in/department/Transport"/>
    <gov:hasCategory rdf:resource="http://gov.semantic.in/category/Transport"/>
    <gov:requiresDocument rdf:resource="http://gov.semantic.in/document/ProofOfAddress"/>
    <gov:associatedWithConcept rdf:resource="http://gov.semantic.in/concept/DrivingLicence"/>
    <gov:relatedTo rdf:resource="http://gov.semantic.in/service/DrivingLicencePermanent"/>
    <gov:hasDescription>Extension of driving licence validity period upon expiry of 20-year term or attainment of age 40.</gov:hasDescription>
    <gov:hasApplicationProcedure>1. Visit Sarathi Portal -&gt; 2. Select 'Services on DL' -&gt; 3. Input DL Number and DOB -&gt; 4. Select Renewal -&gt; 5. Upload medical certificate Form 1-A if applicant age &gt; 40 -&gt; 6. Pay fee online -&gt; 7. Endorsement approved.</gov:hasApplicationProcedure>
    <gov:officialPortalUrl>https://sarathi.parivahan.gov.in</gov:officialPortalUrl>
    <gov:processingTime>5 to 10 Business Days</gov:processingTime>
    <gov:serviceFee>Rs 400</gov:serviceFee>
    <gov:hasSynonym>where can i renew my driving licence</gov:hasSynonym>
    <gov:hasSynonym>renew my driving license</gov:hasSynonym>
    <gov:hasSynonym>expired dl renewal</gov:hasSynonym>
    <gov:hasSynonym>extend driving licence</gov:hasSynonym>
    <gov:hasSynonym>parivahan dl renewal</gov:hasSynonym>
  </rdf:Description>

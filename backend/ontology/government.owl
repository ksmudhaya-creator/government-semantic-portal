  <rdf:Description rdf:about="http://gov.semantic.in/service/AadhaarNewEnrollment">
    <rdf:type rdf:resource="http://gov.semantic.in/ontology#IdentityService"/>
    <gov:serviceName>Aadhaar New Enrollment</gov:serviceName>
    <gov:serviceCode>UIDAI-SRV-002</gov:serviceCode>
    <gov:belongsToDepartment rdf:resource="http://gov.semantic.in/department/UIDAI"/>
    <gov:hasCategory rdf:resource="http://gov.semantic.in/category/Identity"/>
    <gov:requiresDocument rdf:resource="http://gov.semantic.in/document/ProofOfIdentity"/>
    <gov:requiresDocument rdf:resource="http://gov.semantic.in/document/ProofOfAddress"/>
    <gov:requiresDocument rdf:resource="http://gov.semantic.in/document/ProofOfDOB"/>
    <gov:associatedWithConcept rdf:resource="http://gov.semantic.in/concept/IdentityCard"/>
    <gov:relatedTo rdf:resource="http://gov.semantic.in/service/AadhaarAddressUpdate"/>
    <gov:hasDescription>Fresh enrollment for Indian residents to receive their 12-digit unique biographical and biometric identity.</gov:hasDescription>
    <gov:hasApplicationProcedure>1. Book appointment at nearest Aadhaar Seva Kendra -&gt; 2. Fill Enrolment Form -&gt; 3. Submit biometric scans (iris, 10 fingerprints, photograph) -&gt; 4. Collect acknowledgement slip with 28-digit Enrolment ID (EID).</gov:hasApplicationProcedure>
    <gov:officialPortalUrl>https://appointments.uidai.gov.in</gov:officialPortalUrl>
    <gov:processingTime>15 to 30 Days</gov:processingTime>
    <gov:serviceFee>Free (Government Subsidized)</gov:serviceFee>
    <gov:hasSynonym>apply for aadhaar card</gov:hasSynonym>
    <gov:hasSynonym>new aadhaar registration</gov:hasSynonym>
    <gov:hasSynonym>first time aadhaar</gov:hasSynonym>
    <gov:hasSynonym>enroll for aadhaar</gov:hasSynonym>
    <gov:hasSynonym>aadhaar apply</gov:hasSynonym>
    <gov:hasSynonym>get aadhaar</gov:hasSynonym>
  </rdf:Description>
  <rdf:Description rdf:about="http://gov.semantic.in/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">National Government Service Portal Knowledge Ontology</rdfs:label>
    <rdfs:comment xml:lang="en">Formal Web Ontology Language (OWL) knowledge base modeling public government services, departments, citizen eligibility, required documents, and semantic relationships.</rdfs:comment>
    <owl:versionInfo>2.0.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="http://gov.semantic.in/service/PassportRenewalReissue">
    <rdf:type rdf:resource="http://gov.semantic.in/ontology#TravelService"/>
    <gov:serviceName>Passport Renewal and Re-issue</gov:serviceName>
    <gov:serviceCode>MEA-SRV-002</gov:serviceCode>
    <gov:belongsToDepartment rdf:resource="http://gov.semantic.in/department/PassportSeva"/>
    <gov:hasCategory rdf:resource="http://gov.semantic.in/category/Travel"/>
    <gov:requiresDocument rdf:resource="http://gov.semantic.in/document/ProofOfAddress"/>
    <gov:associatedWithConcept rdf:resource="http://gov.semantic.in/concept/IdentityCard"/>
    <gov:relatedTo rdf:resource="http://gov.semantic.in/service/PassportFreshApplication"/>
    <gov:hasDescription>Re-issue of Indian passport due to validity expiration, exhaustion of visa stamp pages, or change in personal particulars.</gov:hasDescription>
    <gov:hasApplicationProcedure>1. Sign in to Passport Seva Portal -&gt; 2. Apply for 'Re-issue of Passport' -&gt; 3. Enter old passport number and expiry -&gt; 4. Schedule appointment at nearest PSK -&gt; 5. Submit old booklet for cancellation.</gov:hasApplicationProcedure>
    <gov:officialPortalUrl>https://www.passportindia.gov.in</gov:officialPortalUrl>
    <gov:processingTime>7 to 14 Business Days</gov:processingTime>
    <gov:serviceFee>Rs 1,500</gov:serviceFee>
    <gov:hasSynonym>renew passport</gov:hasSynonym>
    <gov:hasSynonym>expired passport renewal</gov:hasSynonym>
    <gov:hasSynonym>passport re-issue</gov:hasSynonym>
    <gov:hasSynonym>passport booklet extension</gov:hasSynonym>
    <gov:hasSynonym>passport pages over</gov:hasSynonym>
  </rdf:Description>
  <rdf:Description rdf:about="http://gov.semantic.in/service/RationCardApplication">
    <rdf:type rdf:resource="http://gov.semantic.in/ontology#WelfareService"/>
    <gov:serviceName>Ration Card Application (NFSA)</gov:serviceName>
    <gov:serviceCode>PDS-SRV-001</gov:serviceCode>
    <gov:belongsToDepartment rdf:resource="http://gov.semantic.in/department/PDS"/>
    <gov:hasCategory rdf:resource="http://gov.semantic.in/category/Welfare"/>

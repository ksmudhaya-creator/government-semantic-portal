    gov:serviceCode "PDS-SRV-001" ;
    gov:belongsToDepartment dept:PDS ;
    gov:hasCategory cat:Welfare ;
    gov:requiresDocument doc:ProofOfAddress , doc:IncomeProof ;
    gov:hasDescription "Public food security card entitling beneficiary families to subsidized food grains and civil supplies under NFSA." ;
    gov:hasApplicationProcedure "1. Visit state food & civil supplies portal -> 2. Apply for new Ration Card -> 3. Provide Aadhaar IDs of all family members -> 4. Submit income certificate -> 5. Food Inspector inspects premises -> 6. Card sanctioned." ;
    gov:officialPortalUrl "https://nfsa.gov.in" ;
    gov:processingTime "20 to 30 Business Days" ;
    gov:serviceFee "Rs 20 to Rs 50" ;
    gov:hasSynonym "apply for ration card" , "bpl card apply" , "food security card" , "new rashan card" , "pds card online" .

# 15. Income Certificate
srv:IncomeCertificate a gov:RevenueService ;
    gov:serviceName "Income Certificate (e-District)" ;
    gov:serviceCode "REV-SRV-001" ;
    gov:belongsToDepartment dept:Revenue ;
    gov:hasCategory cat:Revenue ;
    gov:requiresDocument doc:IncomeProof , doc:ProofOfAddress ;
    gov:associatedWithConcept concept:IncomeVerification ;
    gov:relatedTo srv:CommunityCasteCertificate ;
    gov:hasDescription "Statutory revenue certificate certifying total annual family income from all legitimate sources for scholarships and reservations." ;
    gov:hasApplicationProcedure "1. Visit state e-District portal -> 2. Choose 'Revenue Services' -> 'Income Certificate' -> 3. Declare family income sources -> 4. Upload salary slip or income affidavit -> 5. Verification by VAO and Tehsildar -> 6. Download digitally signed PDF." ;
    gov:officialPortalUrl "https://edistrict.gov.in" ;
    gov:processingTime "7 to 15 Days" ;
    gov:serviceFee "Rs 30 to Rs 60" ;
    gov:hasSynonym "how to get income certificate" , "apply aay praman patra" , "revenue income proof" , "annual income certificate" , "tahsildar income cert" .

# 16. Community / Caste Certificate
srv:CommunityCasteCertificate a gov:RevenueService ;
    gov:serviceName "Community and Caste Certificate" ;
    gov:serviceCode "REV-SRV-002" ;
    gov:belongsToDepartment dept:Revenue ;
    gov:hasCategory cat:Revenue ;
    gov:requiresDocument doc:CasteProof , doc:ProofOfAddress ;
    gov:associatedWithConcept concept:CasteClassification ;

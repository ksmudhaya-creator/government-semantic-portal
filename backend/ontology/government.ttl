    gov:hasApplicationProcedure "1. Log into e-District portal -> 2. Select Caste/Community Certificate -> 3. Provide paternal lineage community records -> 4. Local Revenue Inspector enquiry -> 5. Sub-Divisional Magistrate / Tehsildar signs credential." ;
    gov:officialPortalUrl "https://edistrict.gov.in" ;
    gov:processingTime "15 to 30 Days" ;
    gov:serviceFee "Rs 50" ;
    gov:hasSynonym "how can i apply for a caste certificate" , "community certificate apply" , "obc certificate" , "sc st certificate online" , "jaati praman patra" .

# 17. Birth Certificate Registration
srv:BirthCertificateRegistration a gov:IdentityService ;
    gov:serviceName "Birth Certificate Registration" ;
    gov:serviceCode "CRS-SRV-001" ;
    gov:belongsToDepartment dept:CRS ;
    gov:hasCategory cat:Vital ;
    gov:requiresDocument doc:HospitalDischarge , doc:ProofOfAddress ;
    gov:associatedWithConcept concept:IdentityCard ;
    gov:hasDescription "Statutory legal registration of child birth under Registration of Births and Deaths Act establishing legal existence." ;
    gov:hasApplicationProcedure "1. Hospital reports birth event to registrar or parent applies on crsorgi.gov.in -> 2. Verify parental identity -> 3. Municipal Registrar approves -> 4. Digitally verifiable QR code certificate generated." ;
    gov:officialPortalUrl "https://crsorgi.gov.in" ;
    gov:processingTime "7 to 14 Days" ;
    gov:serviceFee "Free within 21 days (Late fee applicable thereafter)" ;
    gov:hasSynonym "apply birth certificate" , "janam praman patra" , "register new child birth" , "download municipal birth certificate" .
